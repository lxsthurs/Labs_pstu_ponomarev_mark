#include <iostream>
#include <cstring>
using namespace std;

const int MAXN = 15;                 // N*N <= 225 символов
const int MAXLEN = MAXN * MAXN;

// возвращает N, если len = N*N, иначе 0
int sideOf(int len)
{
    for (int n = 1; n <= MAXN; n++)
        if (n * n == len) return n;
    return 0;
}

// строка состоит только из цифр?
bool onlyDigits(const char s[])
{
    for (int i = 0; s[i]; i++)
        if (s[i] < '0' || s[i] > '9') return false;
    return true;
}

// разбиение строки на подстроки длиной n и запись их в строки массива
void fillMatrix(int a[][MAXN], const char s[], int n)
{
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            a[i][j] = s[i * n + j] - '0';
}

void printMatrix(int a[][MAXN], int n)
{
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++) cout << a[i][j] << ' ';
        cout << '\n';
    }
}

// обмен двух строк массива
void swapRows(int a[][MAXN], int n, int i, int j)
{
    for (int c = 0; c < n; c++)
    {
        int t = a[i][c];
        a[i][c] = a[j][c];
        a[j][c] = t;
    }
}

// строки можно переставлять произвольно, поэтому первый столбец можно
// расположить строго по возрастанию тогда и только тогда, когда все его
// элементы (первые цифры подстрок) различны
bool firstDigitsDistinct(int a[][MAXN], int n)
{
    for (int i = 0; i < n; i++)
        for (int j = i + 1; j < n; j++)
            if (a[i][0] == a[j][0]) return false;
    return true;
}

// упорядочение строк по первому столбцу (метод выбора)
void sortRows(int a[][MAXN], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        int m = i;
        for (int j = i + 1; j < n; j++)
            if (a[j][0] < a[m][0]) m = j;
        if (m != i) swapRows(a, n, i, m);
    }
}

int main()
{
    char s[MAXLEN + 2];
    int a[MAXN][MAXN];

    cout << "Введите строку из N*N цифр: ";
    cin >> s;

    if (!onlyDigits(s))
    {
        cout << "Ошибка: строка должна состоять только из цифр\n";
        return 1;
    }
    int n = sideOf((int)strlen(s));
    if (n == 0)
    {
        cout << "Ошибка: длина строки (" << strlen(s)
             << ") не является квадратом натурального числа (N <= "
             << MAXN << ")\n";
        return 1;
    }

    cout << "N = " << n << "\nМассив при записи подстрок по порядку:\n";
    fillMatrix(a, s, n);
    printMatrix(a, n);

    if (firstDigitsDistinct(a, n))
    {
        sortRows(a, n);
        cout << "\nМожно. Расположение строк, при котором первый столбец "
                "возрастает:\n";
        printMatrix(a, n);
    }
    else
        cout << "\nНельзя: первые цифры подстрок повторяются, "
                "строгое возрастание первого столбца невозможно\n";
    return 0;
}
