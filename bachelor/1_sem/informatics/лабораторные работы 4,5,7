#include <iostream>
using namespace std;

const int N = 100;               // максимальная длина массива

// индекс элемента, предшествующего i в кольце (движение справа налево)
int prevIdx(int i, int n)
{
    return (i - 1 + n) % n;      // от первого элемента переходим к последнему
}

// печать кольца, начиная с K-го элемента (K считается с 1) и далее
// справа налево по кольцу до (K+1)-го элемента
void printRing(const int a[], int n, int k)
{
    if (n == 0)
    {
        cout << "Кольцо пусто\n";
        return;
    }
    int i = ((k - 1) % n + n) % n;       // приводим K к номеру в кольце
    for (int c = 0; c < n; c++)
    {
        cout << a[i] << ' ';
        i = prevIdx(i, n);
    }
    cout << '\n';
}

// добавление нового первого элемента
bool addFirst(int a[], int &n, int x)
{
    if (n >= N) return false;
    for (int i = n; i > 0; i--) a[i] = a[i - 1];
    a[0] = x;
    n++;
    return true;
}

// добавление нового последнего элемента
bool addLast(int a[], int &n, int x)
{
    if (n >= N) return false;
    a[n++] = x;
    return true;
}

// удаление из кольца всех нечетных элементов
void removeOdd(int a[], int &n)
{
    int w = 0;
    for (int i = 0; i < n; i++)
        if (a[i] % 2 == 0)               // четные (в т.ч. отрицательные) оставляем
            a[w++] = a[i];
    n = w;                               // меняем реальную длину массива
}

int main()
{
    int a[N], n, k;

    cout << "Количество элементов кольца (1.." << N << "): ";
    cin >> n;
    if (!cin || n < 1 || n > N)
    {
        cout << "Ошибка: недопустимая длина массива\n";
        return 1;
    }
    cout << "Введите " << n << " целых чисел: ";
    for (int i = 0; i < n; i++) cin >> a[i];
    cout << "Номер K, с которого начинать печать: ";
    cin >> k;
    if (!cin || k < 1)
    {
        cout << "Ошибка: K должно быть натуральным числом\n";
        return 1;
    }

    cout << "\nИсходное кольцо (в порядке записи): ";
    for (int i = 0; i < n; i++) cout << a[i] << ' ';
    cout << "\n\n2) Печать с " << k << "-го элемента справа налево по кольцу:\n";
    printRing(a, n, k);

    int x, y;
    cout << "\nЗначение нового первого элемента: ";
    cin >> x;
    cout << "Значение нового последнего элемента: ";
    cin >> y;
    if (!addFirst(a, n, x) || !addLast(a, n, y))
    {
        cout << "Ошибка: массив переполнен\n";
        return 1;
    }
    cout << "\n3) Кольцо после добавления первого и последнего элементов:\n";
    for (int i = 0; i < n; i++) cout << a[i] << ' ';
    cout << '\n';

    removeOdd(a, n);
    cout << "\n4) Кольцо после удаления нечетных элементов:\n";
    for (int i = 0; i < n; i++) cout << a[i] << ' ';
    cout << '\n';

    cout << "\n5) Печать с " << k << "-го элемента справа налево по кольцу:\n";
    if (n > 0 && k > n)
        cout << "(в кольце " << n << " эл., K приведено к номеру "
             << (k - 1) % n + 1 << ")\n";
    printRing(a, n, k);
    return 0;
}
