#include <iostream>
#include <cstring>
#include <cstdarg>
#include <cmath>
using namespace std;

// ===================== 7.1 =====================

// а) минимальный элемент массива целых чисел
int minimum(int n, const int a[])
{
    int m = a[0];
    for (int i = 1; i < n; i++)
        if (a[i] < m) m = a[i];
    return m;
}

// символ-разделитель слов
bool isSep(char c)
{
    return c == ' ' || c == '\t' || c == '.' || c == ',' ||
           c == ';' || c == ':' || c == '!' || c == '?';
}

// б) длина самого короткого слова строки (0, если слов нет)
int minimum(const char s[])
{
    int best = 0, len = 0;
    for (int i = 0; ; i++)
    {
        if (s[i] != '\0' && !isSep(s[i]))
            len++;
        else
        {
            if (len > 0 && (best == 0 || len < best)) best = len;
            len = 0;
            if (s[i] == '\0') break;
        }
    }
    return best;
}


// ===================== 7.2 =====================

const double EPS = 1e-9;

// принадлежит ли точка (x, y) окружности радиуса R (центр в точке (0, 0))
inline bool onCircle(double x, double y, double R)
{
    return fabs(sqrt(x * x + y * y) - R) < EPS;
}

// n - число параметров, следующих за n: сначала радиус R, затем пары x, y.
// Все параметры должны иметь тип double.
int belong(int n, ...)
{
    va_list args;
    va_start(args, n);
    double R = va_arg(args, double);
    int count = 0;
    for (int p = 0; p < (n - 1) / 2; p++)
    {
        double x = va_arg(args, double);
        double y = va_arg(args, double);
        if (onCircle(x, y, R)) count++;
    }
    va_end(args);
    return count;
}


int main()
{
    cout << "=== 7.1 ===\n";
    int x[] = {17, 5, 23, -4, 9, 12, 31};
    int n = sizeof(x) / sizeof(x[0]);
    const char text[] = "Programming in C++ is fun and useful.";

    cout << "Массив: ";
    for (int i = 0; i < n; i++) cout << x[i] << ' ';
    cout << "\nМинимальный элемент массива: " << minimum(n, x) << '\n';

    cout << "\nСтрока: \"" << text << "\"\n";
    cout << "Длина самого короткого слова: " << minimum(text) << '\n';
    
    cout << "\n=== 7.2 ===\n";
    cout << "Вызов 1 (3 параметра: R=5, 1 точка): "
         << belong(3, 5.0, 3.0, 4.0) << '\n';

    cout << "Вызов 2 (9 параметров: R=5, 4 точки): "
         << belong(9, 5.0, 3.0, 4.0, -3.0, 4.0, 0.0, -5.0, 2.0, 2.0) << '\n';

    cout << "Вызов 3 (11 параметров: R=10, 5 точек): "
         << belong(11, 10.0, 6.0, 8.0, -8.0, 6.0, 0.0, 10.0, 5.0, 5.0, 10.0, 0.0)
         << '\n';
    return 0;
}
